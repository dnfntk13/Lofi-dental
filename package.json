{
  "name": "lofi-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build:articles": "node tools/build-articles.mjs",
    "build:prices": "node tools/build-price-guide-schema.mjs",
    "check:prices": "node --test tests/price-guide-aeo.test.mjs",
    "check:plugin": "node --test tests/public-lofi-mcp.test.mjs",
    "dev": "node server.mjs",
    "dentweb:sync": "node tools/dentweb-sync-agent.mjs",
    "dentweb:agent": "node tools/dentweb-sync-agent.mjs --daemon",
    "dentweb:install-launcher": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File tools/install-dentweb-agent-protocol.ps1",
    "dentweb:configure": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File tools/configure-dentweb-agent.ps1",
    "dentweb:ai": "node tools/dentweb-sync-agent.mjs --ai",
    "preview": "PORT=4173 node server.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "imap": "^0.8.19",
    "mailparser": "^3.6.7",
    "mongodb": "^7.3.0",
    "nodemailer": "^9.0.1",
    "pdf-parse": "^1.1.1",
    "zod": "^4.6.7"
  }
}
